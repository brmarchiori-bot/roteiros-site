# =====================================================
# Menos Roteiros — variáveis de ambiente
# Copiar este arquivo para .env.local e preencher.
# .env.local NÃO vai pro git.
# =====================================================

# URL pública do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------
# SEO — verificações de propriedade
# Preencher quando cadastrar o site nos serviços abaixo.
# -----------------------------------------------------

# Google Search Console — pega o token em search.google.com/search-console
# NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Bing Webmaster Tools
# NEXT_PUBLIC_BING_VERIFICATION=

# Yandex Webmaster (opcional)
# NEXT_PUBLIC_YANDEX_VERIFICATION=

# -----------------------------------------------------
# Sanity CMS — painel de edição em /studio
# Pega os valores em sanity.io → Project → API
# Quando vazio, o site usa fallback de src/content/*.ts
# -----------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Segurança editorial: o Studio pode ficar conectado enquanto a Home continua
# usando src/content/*.ts. Ativar apenas depois de migrar e revisar o dataset.
NEXT_PUBLIC_SANITY_CONTENT_ENABLED=false

# -----------------------------------------------------
# Preview editorial — todas são server-only
# -----------------------------------------------------
# Leitura de drafts e validação do fluxo oficial do Presentation Tool.
# Use exclusivamente um token Viewer e configure-o apenas no servidor.
# SANITY_API_READ_TOKEN=
# SANITY_STUDIO_URL=
# SANITY_API_VERSION=2025-01-01

# -----------------------------------------------------
# Password protection (preview privado)
# Quando ativa, o site inteiro pede usuário + senha via Basic Auth.
# /studio (Sanity) fica fora do bloqueio.
#
# Ligar/desligar:
#   - Ligado   → ENABLE_PASSWORD=true  (mais as duas de baixo preenchidas)
#   - Desligado → remover a var ou qualquer outro valor (ex: 'false')
#
# Credenciais: definir SÓ na Vercel (Settings → Environment Variables),
# marcar pros ambientes que você quer proteger (Preview, Production).
# NUNCA commitar senha real — este arquivo é só exemplo.
# -----------------------------------------------------
# ENABLE_PASSWORD=true
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASSWORD=troqueme

# -----------------------------------------------------
# Portfólio privado
# Slug secreto com pelo menos 24 caracteres.
# A URL final será /portfolio/VALOR_DESTA_VARIAVEL
# Gere um valor aleatório e compartilhe a URL somente de forma manual.
# -----------------------------------------------------
# PRIVATE_PORTFOLIO_SLUG=gere-uma-chave-longa-e-aleatoria

# Vercel Analytics não exige variável local.
# Formulários permanecem desativados até a escolha de um provedor.
